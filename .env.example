NEXT_PUBLIC_APP_MODE=prototype
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
CLEANOPS_DEMO_INGRESS_ENABLED=false
CLEANOPS_DEMO_INGRESS_TOKEN=replace-with-at-least-24-characters
CLEANOPS_DEMO_WORKER_ID=cleanops-local-worker
# Live quality remains disabled unless all three values below are set. The configured
# amount is a per-attempt ceiling in cents; keep it small for synthetic evaluation.
OPENAI_QUALITY_LIVE_ENABLED=false
OPENAI_QUALITY_MODEL=gpt-5-mini
OPENAI_QUALITY_ATTEMPT_CENTS=1
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_VERIFY_TOKEN=replace-with-at-least-24-characters
WHATSAPP_APP_SECRET=replace-with-at-least-24-characters
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
WHATSAPP_APP_ID=replace-with-meta-app-id
WHATSAPP_WABA_ID=replace-with-whatsapp-business-account-id
WHATSAPP_PHONE_NUMBER_ID=replace-with-dedicated-phone-number-id
WHATSAPP_REQUIRED_TEMPLATE_NAMES=cleaning_update
# Pin a version verified in the customer sandbox; do not use an implicit latest version.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_WORKER_TOKEN=replace-with-at-least-24-characters
WHATSAPP_WORKER_ID=cleanops-whatsapp-worker

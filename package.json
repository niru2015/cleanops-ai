{
  "name": "cleanops-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:db:postgres": "scripts/test-database-postgres.sh",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:storage": "node scripts/test-evidence-storage.mjs",
    "worker:messages": "node --env-file=.env.local scripts/run-ingress-worker.mjs",
    "worker:whatsapp": "node --env-file=.env.local scripts/run-whatsapp-worker.mjs",
    "whatsapp:readiness": "node --env-file=.env.local scripts/check-whatsapp-readiness.mjs",
    "demo:replay-evidence": "node --env-file=.env.local scripts/replay-golden-evidence.mjs",
    "demo:provision-logins": "node --env-file=.env.local scripts/provision-demo-logins.mjs",
    "demo:generate": "node scripts/demo-scenario.mjs generate",
    "demo:reset": "node scripts/demo-scenario.mjs reset",
    "demo:assert": "node scripts/demo-scenario.mjs assert",
    "demo:presenter": "node scripts/demo-scenario.mjs presenter",
    "demo:tornado": "node scripts/run-tornado-demo.mjs",
    "test:scenario": "node scripts/test-demo-scenario.mjs",
    "test:contract-concurrency": "node scripts/test-contract-concurrency.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
